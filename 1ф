@bot.callback_query_handler(func=lambda c: c.data.startswith("check_ad_"))
def check_subscription(call):
    user_id = call.from_user.id
    ad_id = call.data.replace("check_ad_", "")

    bot.answer_callback_query(call.id)

    if ad_id not in data["ads"]:
        bot.send_message(call.message.chat.id, "❌ Задание не найдено.")
        return

    ad = data["ads"][ad_id]

    if ad["status"] != "approved":
        bot.send_message(call.message.chat.id, "❌ Задание недоступно.")
        return

    if int(ad["owner"]) == user_id:
        bot.send_message(call.message.chat.id, "❌ Нельзя выполнять свою рекламу.")
        return

    user = get_user(user_id)

    if ad_id in user["completed"]:
        bot.send_message(call.message.chat.id, "✅ Задание уже выполнено.")
        return

    try:
        member = bot.get_chat_member(ad["channel"], user_id)

        if member.status not in ("member", "administrator", "creator"):
            bot.send_message(
                call.message.chat.id,
                "❌ Ты ещё не подписан на канал."
            )
            return

    except Exception:
        bot.send_message(
            call.message.chat.id,
            "❌ Не удалось проверить подписку."
        )
        return

    with data_lock:
        if ad_id in user["completed"]:
            return

        user["completed"].append(ad_id)
        ad["completed"].append(str(user_id))

        user["balance"] += AD_REWARD

        referrer_id = user.get("referrer")

        if referrer_id:
            referrer = get_user(referrer_id)

            referral_reward = AD_REWARD * REFERRAL_TASK_PERCENT / 100
            referrer["balance"] += referral_reward
            referrer["referral_earnings"] += referral_reward

            if not user["referral_bonus_given"]:
                referrer["balance"] += REFERRAL_BONUS
                user["referral_bonus_given"] = True

                try:
                    bot.send_message(
                        referrer_id,
                        f"🎉 Твой приглашённый пользователь "
                        f"выполнил первое задание!\n"
                        f"Бонус: {REFERRAL_BONUS} GRAM."
                    )
                except Exception:
                    pass

        save_data()

    bot.send_message(
        call.message.chat.id,
        f"🎉 Подписка подтверждена!\n"
        f"Начислено: {AD_REWARD} GRAM.\n"
        f"Баланс: {format_balance(user['balance'])} GRAM"
    )


