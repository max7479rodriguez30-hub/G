@bot.message_handler(func=lambda m: m.text == "🆘 Поддержка")
def support_start(message):
    support_waiting.add(message.from_user.id)

    bot.send_message(
        message.chat.id,
        "🆘 ПОДДЕРЖКА PR GRAM\n\n"
        "Напишите сообщение для администратора.\n"
        "Ваше сообщение будет передано в поддержку.\n\n"
        "Для отмены отправьте /cancel"
    )


@bot.message_handler(
    func=lambda m: m.from_user.id in support_waiting,
    content_types=["text"]
)
def support_receive(message):
    user_id = message.from_user.id

    if message.text == "/cancel":
        support_waiting.discard(user_id)
        bot.send_message(message.chat.id, "❌ Обращение отменено.")
        return

    support_waiting.discard(user_id)

    keyboard = types.InlineKeyboardMarkup()

    keyboard.add(
        types.InlineKeyboardButton(
            "↩️ Ответить",
            callback_data=f"support_reply_{user_id}"
        )
    )

    try:
        bot.send_message(
            ADMIN_ID,
            f"🆘 НОВОЕ ОБРАЩЕНИЕ\n\n"
            f"👤 Пользователь: {message.from_user.first_name}\n"
            f"🆔 ID: {user_id}\n\n"
            f"💬 Сообщение:\n{message.text}",
            reply_markup=keyboard
        )

        bot.send_message(
            message.chat.id,
            "✅ Сообщение отправлено администратору.\n"
            "Ожидайте ответа."
        )

    except Exception:
        bot.send_message(
            message.chat.id,
            "❌ Не удалось отправить сообщение. "
            "Попробуйте позже."
        )


@bot.callback_query_handler(
    func=lambda c: c.data.startswith("support_reply_")
)
def support_reply_button(call):
    if call.from_user.id != ADMIN_ID:
        bot.answer_callback_query(call.id, "Нет доступа.")
        return

    try:
        user_id = int(call.data.replace("support_reply_", ""))
    except ValueError:
        bot.answer_callback_query(call.id, "Неверный ID.")
        return

    support_reply_target[call.from_user.id] = user_id

    bot.answer_callback_query(call.id)

    bot.send_message(
        call.message.chat.id,
        f"✍️ Напишите ответ пользователю {user_id}.\n"
        f"Для отмены отправьте /cancel."
    )


@bot.message_handler(
    func=lambda m: m.from_user.id in support_reply_target,
    content_types=["text"]
)
def support_admin_reply(message):
    if message.from_user.id != ADMIN_ID:
        return

    if message.text == "/cancel":
        support_reply_target.pop(message.from_user.id, None)
        bot.send_message(message.chat.id, "❌ Ответ отменён.")
        return

    user_id = support_reply_target.pop(message.from_user.id)

    try:
        bot.send_message(
            user_id,
            f"🆘 ОТВЕТ ПОДДЕРЖКИ\n\n{message.text}"
        )

        bot.send_message(
            message.chat.id,
            "✅ Ответ отправлен пользователю."
        )

    except Exception:
        bot.send_message(
            message.chat.id,
            "❌ Не удалось отправить ответ.\n"
            "Возможно, пользователь заблокировал бота."
        )


