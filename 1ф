        f"✅ Одобрено: "
        f"{sum(1 for a in data['ads'].values() if a['status'] == 'approved')}"
    )


@bot.callback_query_handler(func=lambda c: c.data.startswith("approve_"))
def approve_ad(call):
    if call.from_user.id != ADMIN_ID:
        bot.answer_callback_query(call.id, "Нет доступа.")
        return

    ad_id = call.data.replace("approve_", "")

    if ad_id not in data["ads"]:
        bot.answer_callback_query(call.id, "Реклама не найдена.")
        return

    ad = data["ads"][ad_id]

    if ad["status"] != "pending":
        bot.answer_callback_query(call.id, "Уже обработано.")
        return

    ad["status"] = "approved"
    save_data()

    bot.answer_callback_query(call.id, "Реклама одобрена.")

    bot.send_message(
        ad["owner"],
        f"✅ Твоя реклама №{ad_id} одобрена!"
    )

    bot.send_message(
        ADMIN_ID,
        f"✅ Реклама №{ad_id} одобрена."
    )


@bot.callback_query_handler(func=lambda c: c.data.startswith("reject_"))
def reject_ad(call):
    if call.from_user.id != ADMIN_ID:
        bot.answer_callback_query(call.id, "Нет доступа.")
        return

    ad_id = call.data.replace("reject_", "")

    if ad_id not in data["ads"]:
        bot.answer_callback_query(call.id, "Реклама не найдена.")
        return

    ad = data["ads"][ad_id]

    if ad["status"] != "pending":
        bot.answer_callback_query(call.id, "Уже обработано.")
        return

    ad["status"] = "rejected"

    owner = get_user(ad["owner"])
    owner["balance"] += AD_CREATE_COST

    save_data()

    bot.answer_callback_query(call.id, "Реклама отклонена.")

    bot.send_message(
        ad["owner"],
        f"❌ Твоя реклама №{ad_id} отклонена.\n"
        f"Возвращено: {AD_CREATE_COST} GRAM."
    )

    bot.send_message(
        ADMIN_ID,
        f"❌ Реклама №{ad_id} отклонена. Баланс возвращён."
    )


