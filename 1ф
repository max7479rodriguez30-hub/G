        waiting_ad_link.discard(user_id)
        bot.send_message(message.chat.id, "❌ Создание рекламы отменено.")
        return

    channel = parse_public_channel_link(message.text)

    if not channel:
        bot.send_message(
            message.chat.id,
            "❌ Неверная ссылка.\n"
            "Используй https://t.me/channel или @channel"
        )
        return

    try:
        member = bot.get_chat_member(channel, user_id)

        if member.status not in ("administrator", "creator"):
            bot.send_message(
                message.chat.id,
                "❌ Ты должен быть администратором этого канала."
            )
            return

        bot_member = bot.get_chat_member(channel, bot.get_me().id)

        if bot_member.status != "administrator":
            bot.send_message(
                message.chat.id,
                "❌ Добавь бота администратором канала, "
                "чтобы он мог проверять подписки."
            )
            return

    except Exception:
        bot.send_message(
            message.chat.id,
            "❌ Не удалось проверить канал.\n"
            "Проверь ссылку и права бота."
        )
        return

    user = get_user(user_id)

