@bot.pre_checkout_query_handler(func=lambda query: True)
def process_pre_checkout(pre_checkout_query):
    payload = pre_checkout_query.invoice_payload

    if not payload.startswith("gram_"):
        bot.answer_pre_checkout_query(
            pre_checkout_query.id,
            ok=False,
            error_message="Неизвестный товар."
        )
        return

    package_id = payload.replace("gram_", "")

    if package_id not in GRAM_PACKAGES:
        bot.answer_pre_checkout_query(
            pre_checkout_query.id,
            ok=False,
            error_message="Пакет не найден."
        )
        return

    package = GRAM_PACKAGES[package_id]

    if (
        pre_checkout_query.currency != "XTR"
        or pre_checkout_query.total_amount != package["stars"]
    ):
        bot.answer_pre_checkout_query(
            pre_checkout_query.id,
            ok=False,
            error_message="Неверная сумма оплаты."
        )
        return

    bot.answer_pre_checkout_query(
        pre_checkout_query.id,
        ok=True
    )


@bot.message_handler(content_types=["successful_payment"])
def successful_payment(message):
    payment = message.successful_payment
    charge_id = payment.telegram_payment_charge_id

    payload = payment.invoice_payload

    if not payload.startswith("gram_"):
        return

    package_id = payload.replace("gram_", "")

    if package_id not in GRAM_PACKAGES:
        return

    package = GRAM_PACKAGES[package_id]

    if (
        payment.currency != "XTR"
        or payment.total_amount != package["stars"]
    ):
        return

    user = get_user(message.from_user.id)

    with data_lock:
        if charge_id in data["processed_payments"]:
            return

        user["balance"] += package["gram"]
        data["processed_payments"].append(charge_id)
        save_data()

    bot.send_message(
        message.chat.id,
        f"✅ Оплата прошла успешно!\n\n"
        f"Начислено: {package['gram']} GRAM\n"
        f"Новый баланс: {format_balance(user['balance'])} GRAM",
        reply_markup=main_keyboard(message.from_user.id)
    )


