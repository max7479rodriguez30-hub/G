def default_data():
    return {
        "users": {},
        "ads": {},
        "next_ad_id": 1,
        "processed_payments": []
    }


def load_data():
    if not os.path.exists(DATA_FILE):
        return default_data()

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            saved = json.load(file)

        if not isinstance(saved, dict):
            return default_data()

        saved.setdefault("users", {})
        saved.setdefault("ads", {})
        saved.setdefault("next_ad_id", 1)
        saved.setdefault("processed_payments", [])

        for user in saved["users"].values():
            user.setdefault("balance", START_BALANCE)
            user.setdefault("completed", [])
            user.setdefault("referrals", [])
            user.setdefault("referrer", None)
            user.setdefault("referral_bonus_given", False)
            user.setdefault("referral_earnings", 0)

        for ad in saved["ads"].values():
            ad.setdefault("status", "pending")
            ad.setdefault("completed", [])

        return saved

    except (json.JSONDecodeError, OSError):
        return default_data()


data = load_data()


def save_data():
    with data_lock:
        temporary_file = DATA_FILE + ".tmp"

        with open(temporary_file, "w", encoding="utf-8") as file:
            json.dump(data, file, ensure_ascii=False, indent=4)

        os.replace(temporary_file, DATA_FILE)


def get_user(user_id):
    user_id = str(user_id)

    with data_lock:
        if user_id not in data["users"]:
            data["users"][user_id] = {
                "balance": START_BALANCE,
                "completed": [],
                "referrals": [],
                "referrer": None,
                "referral_bonus_given": False,
                "referral_earnings": 0
            }

        return data["users"][user_id]


def format_balance(value):
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return str(value)


